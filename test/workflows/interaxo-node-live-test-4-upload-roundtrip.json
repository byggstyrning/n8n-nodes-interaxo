      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const entryId = $input.first().json.entryId ?? $input.first().json.id;\nconst content = 'n8n-nodes-interaxo upload test — run ' + $execution.id + ' round ' + ($input.first().json.round ?? 1);\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(content, 'utf8'), 'n8n-node-upload-test.txt', 'text/plain');\nreturn [{ json: { entryId }, binary: { data: binary } }];"
      }
    },
    {
      "id": "upload1",
