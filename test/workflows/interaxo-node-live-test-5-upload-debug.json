{
  "name": "Interaxo node live test 5 (upload debug)",
  "nodes": [
    {
      "id": "t",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "createentry",
      "name": "Create Entry",
      "type": "CUSTOM.interaxo",
      "typeVersion": 1,
      "position": [
        180,
        0
      ],
      "parameters": {
        "community": {
          "__rl": true,
          "mode": "id",
          "value": "your-community"
        },
        "room": {
          "__rl": true,
          "mode": "slug",
          "value": "your-room-slug"
        },
        "resource": "entry",
        "operation": "create",
        "folderId": "REPLACE-WITH-A-WORKFLOW-FOLDER-ID",
        "fieldsJson": "[{\"name\": \"NAMN\", \"value\": \"N8N-NODE-DEBUG-TEST\"}, {\"name\": \"BESKRIVNING\", \"value\": \"Temporary - safe to delete\"}, {\"name\": \"04.DISCIPLIN\", \"value\": \"A\"}, {\"name\": \"05.DOKUMENTTYP\", \"value\": \"Övriga dokument\"}, {\"name\": \"STATUS\", \"value\": \"Preliminär\"}, {\"name\": \"REV. BETECKNING\", \"value\": \"-\"}, {\"name\": \"DATUM\", \"value\": \"2026-08-19\"}]",
        "sanitize": true
      },
      "credentials": {
        "interaxoApi": {
          "name": "Interaxo (live test)"
        }
      }
    },
    {
      "id": "mk",
      "name": "Make File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const entryId = $input.first().json.id;\nconst binary = await this.helpers.prepareBinaryData(Buffer.from('debug', 'utf8'), 'debug-test.txt', 'text/plain');\nreturn [{ json: { entryId }, binary: { data: binary } }];"
      }
    },
    {
      "id": "upload",
      "name": "Upload",
      "type": "CUSTOM.interaxo",
      "typeVersion": 1,
      "position": [
        540,
        0
      ],
      "parameters": {
        "community": {
          "__rl": true,
          "mode": "id",
          "value": "your-community"
        },
        "room": {
          "__rl": true,
          "mode": "slug",
          "value": "your-room-slug"
        },
        "resource": "file",
        "operation": "upload",
        "entryId": "={{ $json.entryId }}",
        "binaryPropertyName": "data",
        "fileName": ""
      },
      "credentials": {
        "interaxoApi": {
          "name": "Interaxo (live test)"
        }
      }
    },
    {
      "id": "listchildren",
