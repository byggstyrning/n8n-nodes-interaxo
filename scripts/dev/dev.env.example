# Copy to scripts/dev/dev.env (gitignored) and fill in.
# Two targets: "test" (isolated instance from test/docker-compose.yml) and "prod"
# (your real n8n). Prod is never modified except through the guarded paths in
# deploy.sh / wf.sh: DEV-prefixed, inactive workflows only; restarts only when idle.

TEST_URL=http://localhost:5679
TEST_CONTAINER=n8n-interaxo-test
TEST_API_KEY=
# n8n data dir on the host (the one mounted at /home/node/.n8n). Empty for test:
# test/docker-compose.yml already mounts ./dist as a custom extension.
TEST_DATA_DIR=
# credential to pin on pushed workflows, per credential type, quoted: "<id>:<name>"
TEST_CRED_interaxoApi=

PROD_URL=http://localhost:5678
PROD_CONTAINER=
PROD_API_KEY=
PROD_DATA_DIR=
PROD_CRED_interaxoApi=

# Workflow name prefix required for anything wf.sh pushes to prod
DEV_PREFIX=DEV
